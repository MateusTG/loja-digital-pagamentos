# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
# DATABASE CONFIGURATION
DATABASE_URL=postgresql://user:password@localhost:5435/loja

#PORT CONFIGURATION
PORT=3333

# JWT CONFIGURATION
JWT_SECRET=
JWT_EXPIRES_IN=

# JUNTO SEFAZ CONFIGURATION
GATEWAY_MODE=mock            # mock | juntosefaz
JUNTOSEFAZ_BASE_URL=https://www.juntosefaz.com.br/gateway/api/v1
JUNTOSEFAZ_TOKEN=
WEBHOOK_SECRET=

# CORS CONFIGURATION
CORS_ORIGIN=