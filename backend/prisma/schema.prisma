generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum status {
    AWAITING_PAYMENT
    PAYMENT_CONFIRMED
    PROCESSING
    OUT_FOR_DELIVERY
    DELIVERED
    IN_TRANSIT
    RETURNED
    CANCELED
}

enum paymentStatus{
    PENDING
    IN_ANALYSIS
    APPROVED
    FAILED
    EXPIRED
    CANCELED
    REFUNDED
    DISPUTED
}

model User {
    id           String  @id @default(uuid())
    name         String
    phone_number String  @db.VarChar(100)
    email        String  @unique
    password     String
}

model product {
    id           String  @id @default(uuid())
    name         String
    description  String  
    priceCents   Int
    imageUrl     String
    active       Boolean
}


model Order {
    id          String  @id @default(uuid())
    orderId     String
    productId   String  
    amountCents Float   
    status      status  
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Payment {
    id          String  @id @default(uuid())
    orderId     String
    gatewayId   String  @unique
    method      String
    status      paymentStatus
    pixCode     String
    rawResponse Json
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model PaymentEvent {
    id          String @id @default(uuid())
    paymentId   String
    fromStatus  paymentStatus
    toStatus    paymentStatus
    createdAt   DateTime @default(now())
}