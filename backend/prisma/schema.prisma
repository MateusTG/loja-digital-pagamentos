generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum OrderStatus {
    PENDING
    PAID
    FAILED
    CANCELED
}

enum PaymentStatus {
    PENDING
    APPROVED
    FAILED
    EXPIRED
    CANCELED
    REFUNDED
    DECLINED
}
enum Source {
    WEBHOOK
    POLLING
    SIMULATION
    SYSTEM
}

model User {
    id           String  @id @default(uuid())
    name         String
    phoneNumber String  @db.VarChar(100)
    email        String  @unique
    password     String
}

model Product {
    id           String  @id @default(uuid())
    name         String
    description  String  
    priceCents   Int
    imageUrl     String
    active       Boolean
}


model Order {
    id          String  @id @default(uuid())
    userId      String
    productId   String  
    amountCents Int   
    status      OrderStatus  
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user        User    @relation(fields: [userId], references: [id])
    product     Product @relation(fields: [productId], references: [id])
}

model Payment {
    id          String  @id @default(uuid())
    orderId     String
    gatewayId   String  @unique
    method      String
    status      PaymentStatus
    pixCode     String?
    rawResponse Json
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    order       Order   @relation(fields: [orderId], references: [id])
}

model PaymentEvent {
    id          String @id @default(uuid())
    paymentId   String
    fromStatus  PaymentStatus
    toStatus    PaymentStatus
    source      Source
    createdAt   DateTime @default(now())

    payment     Payment @relation(fields: [paymentId], references: [id])
}